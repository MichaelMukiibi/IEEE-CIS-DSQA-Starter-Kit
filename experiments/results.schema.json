{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSQA experiment result",
  "type": "object",
  "required": [
    "schema_version",
    "started_at",
    "git_commit",
    "git_dirty",
    "python",
    "packages",
    "model",
    "strategy",
    "corpus_dir",
    "corpus_files",
    "gpu",
    "gpu_total_bytes",
    "generation",
    "system_prompt",
    "retrieval",
    "answers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "started_at": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "git_dirty": {
      "type": "boolean"
    },
    "python": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string"
    },
    "strategy": {
      "enum": [
        "zero_shot",
        "rag"
      ]
    },
    "corpus_dir": {
      "type": "string"
    },
    "corpus_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "gpu": {
      "type": "string"
    },
    "gpu_total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "generation": {
      "type": "object",
      "required": [
        "max_new_tokens",
        "do_sample",
        "dtype"
      ]
    },
    "system_prompt": {
      "type": "string"
    },
    "retrieval": {
      "type": "object"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "reference_answer",
          "cold_call",
          "latency_seconds",
          "peak_cuda_allocated_bytes",
          "peak_cuda_reserved_bytes"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "reference_answer": {
            "type": "string"
          },
          "cold_call": {
            "type": "boolean"
          },
          "latency_seconds": {
            "type": "number",
            "minimum": 0
          },
          "peak_cuda_allocated_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "peak_cuda_reserved_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
